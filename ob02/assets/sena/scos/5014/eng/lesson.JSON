type": "name"}, {"content": " a question to ask a person the name of their country", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Where are you from? I'm from China.", "type": "example"}, {"content": "engenn1le02ob02aud05", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " Use these words to ask where people are from.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to speak", "type": "name"}, {"content": "to say words in  a language", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I can speak English and Chinese.", "type": "example"}, {"content": "engenn1le02ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to understand", "type": "name"}, {"content": "to know the meaning of words ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Do you understand what he said?", "type": "example"}, {"content": "engenn1le02ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Japan", "type": "name"}, {"content": "a country in Asia", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He is from Japan.", "type": "example"}, {"content": "engenn1le02ob02aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Japanese", "type": "name"}, {"content": "the language of Japan", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I am learning Japanese.", "type": "example"}, {"content": "engenn1le02ob02aud02", "type": "audio"}]}, {"type": "objectives", "contents": [{"content": "Exchange basic personal information.", "type": "primary"}, {"content": "Understands basic information in English texts according to the communicative topics of this level.", "type": "secondary_1"}, {"content": "Understands basic information in English texts according to the communicative topics of this level.", "type": "secondary_2"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_3"}, {"content": "Understands basic information in English texts according to the communicative topics of this level.", "type": "secondary_4"}, {"content": "Understands basic information in English texts according to the communicative topics of this level.", "type": "secondary_5"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_6"}, {"content": "Understands simple information, vocabulary and expressions in short conversations about personal information. ", "type": "secondary_7"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_8"}]}, {"content": "engenn1le02ob02re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Cut up 16 cards.", "type": "text"}, {"content": "Write the names of countries on 8 cards. ", "type": "text"}, {"content": "Write the nationalities of the countries on the other 8 cards. ", "type": "text"}, {"content": "Turn them over and place them on the table. Don't look! ", "type": "text"}, {"content": "Turn one card. Say the word. ", "type": "text"}, {"content": "Turn another card. Say the word. ", "type": "text"}, {"content": "If they match (correct country and nationality), put them away.", "type": "text"}, {"content": "If they do NOT match, put them back on the table. ", "type": "text"}, {"content": "Take turns with your partner. ", "type": "text"}, {"content": "Play until all the cards are matched up. ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I know the names of different countries. ", "type