erson the name of their country"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Where are you from? I'm from China."}, {"type": "audio", "content": "engenn1le02ob02aud05"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " Use these words to ask where people are from."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to speak"}, {"type": "definition", "content": "to say words in  a language"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I can speak English and Chinese."}, {"type": "audio", "content": "engenn1le02ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to understand"}, {"type": "definition", "content": "to know the meaning of words "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Do you understand what he said?"}, {"type": "audio", "content": "engenn1le02ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Japan"}, {"type": "definition", "content": "a country in Asia"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He is from Japan."}, {"type": "audio", "content": "engenn1le02ob02aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Japanese"}, {"type": "definition", "content": "the language of Japan"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I am learning Japanese."}, {"type": "audio", "content": "engenn1le02ob02aud02"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Exchange basic personal information."}, {"type": "secondary_1", "content": "Understands basic information in English texts according to the communicative topics of this level."}, {"type": "secondary_2", "content": "Understands basic information in English texts according to the communicative topics of this level."}, {"type":