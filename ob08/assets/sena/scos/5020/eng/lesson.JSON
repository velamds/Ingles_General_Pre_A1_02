[{"content": "Can you give me a hand?", "type": "name"}, {"content": "a request for help", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example:  Can you give me a hand, please? I need help.", "type": "example"}, {"content": "engenn1le02ob08aud07", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "Wh- Questions With To Be", "type": "heading"}, {"content": "The Wh- questions words are: what, when, where, who, and why.   You use them to ask for specific information. <br />The answer is NOT  yes or no. ", "type": "describer"}, {"content": "{\"rows\":\"06\",\"columns\":\"03\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Question Word</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Use</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Who\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a person\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Who pays for lunch today?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks for information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What can I help you with?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"When\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about time\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">When is lunch?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a place\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Where is the lunch menu?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Why\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" asks about a reason\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Why are you so hungry?</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"content": "engenn1le02ob08re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Do, Does and Can", "type": "heading"}, {"content": "You often use Do, Does and Can to ask questions. ", "type": "describer"}, {"content": " You use DO when the subject is I, you, we or they.", "type": "text"}, {"content": "Do you like chocolate?", "type": "example"}, {"content": "When the subject is he, she or it, you add DOES to the beginning of the sentence.", "type": "text"}, {"content": "Does she like chocolate?", "type": "example"}, {"content": "You can use CAN to ask someone to do something.", "type": "text"}, {"content": "Can you help me?", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": " Interview a family member about what they eat for lunch. ", "type": "text"}, {"content": "Start each question with: <ul><li>Who ...</li><li>What ...</li> <li>When ...</li> <li>Where ...</li> <li>Why ...</li></ul>", "type": "text"}, {"content": "Write down the answers.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about a family member. ", "type": "text"}, {"content": "I ask <span class=\"italic\">Wh-</span> questions. ", "type": "text"}, {"content": "I write down the answers. ", "type": "text"}]}], "type": "sena", "labs": [{"exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "_data": [{"type": "instructions", "contents": [{"content": "I can ask for and offer help.", "type": "Learning Outcomes"}, {"content": "I can ask <span class=\"italic\">who</span>, <span class=\"italic\">what</span>, <span class=\"italic\">when</span>, <span c